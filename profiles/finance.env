# Finance / fintech profile for local-llm-deploy-kit.
# Load with: cp profiles/finance.env .env
#
# Draws from fintech dispute-ops deployment patterns. Opinions:
#   - Everything prompt-level is PII — treat it that way
#   - Model stays on-prem; outbound to any public LLM must be gated separately
#   - Logs are evidence, not debugging aids — WORM them

OLLAMA_HOST=http://127.0.0.1:11434

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# Larger model that handles tabular reasoning better than 8B. Pull with
#   ollama pull qwen2.5:14b
GATEWAY_DEFAULT_MODEL=qwen2.5:14b

GATEWAY_RATE_LIMIT_PER_MIN=30

# Every prompt and completion goes into the hash-chained audit log. Pair with
# WORM retention per your SOC 2 / PCI requirements.
GATEWAY_LOG_PROMPTS=true

# Redact Luhn-valid card numbers, SSNs, DOBs, emails and US phone numbers before they reach the audit log.
# Pattern-based: bank account numbers, names and addresses are NOT redacted.
# Set to false only if your policy requires verbatim records AND the log store
# has the same access controls as the source system.
GATEWAY_REDACT_PROMPTS=true
GATEWAY_LOG_DIR=/var/log/local-llm-deploy-kit

GATEWAY_DB_PATH=/var/lib/local-llm-deploy-kit/gateway.db
GATEWAY_ADMIN_BOOTSTRAP_KEY=

# Document collections: only admins and explicit grants (collection or document access lists, or
# reader:<collection> roles from SSO groups) can read a collection. "open" lets every user-role caller
# read collections that have no access list.
GATEWAY_COLLECTION_DEFAULT_ACCESS=restricted

# Encryption at rest for document passages and vectors (and the free-text fields of audit entries).
# Create a keyring first, store it apart from backups, then uncomment:
#   python scripts/keys.py generate --keyring /etc/local-llm-deploy-kit/keyring.json --activate
# GATEWAY_ENCRYPT_AT_REST=true
# GATEWAY_AUDIT_ENCRYPT_TEXT=true
# GATEWAY_ENCRYPTION_KEY_FILE=/etc/local-llm-deploy-kit/keyring.json

# Model supply chain: serve only models pinned in the lock file whose digest matches what the model
# server reports (403 otherwise). Pin after installing models, review the digests, then restart:
#   python scripts/pin_models.py --out /etc/local-llm-deploy-kit/models.lock.json
GATEWAY_MODEL_POLICY=enforce
GATEWAY_MODEL_LOCK_FILE=/etc/local-llm-deploy-kit/models.lock.json
