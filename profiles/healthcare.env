# Healthcare / HIPAA-adjacent profile for private-llm-platform.
# Load with: cp profiles/healthcare.env .env  (then edit as needed)
#
# Rationale notes inline. These defaults assume you're deploying on-prem
# because the data cannot leave the facility. If any of these are wrong for
# your deployment, you probably shouldn't be using a local-first setup.

OLLAMA_HOST=http://127.0.0.1:11434

# Bind to localhost ONLY — expose through a reverse proxy on the facility VPN,
# not directly on the network.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# Smaller model that fits most clinical laptops without a GPU. Swap for
# qwen2.5:14b or llama3.1:70b on dedicated hardware.
GATEWAY_DEFAULT_MODEL=llama3.1:8b

# Lower RPM — healthcare apps rarely need high throughput and lower RPM
# naturally rate-limits runaway client bugs.
GATEWAY_RATE_LIMIT_PER_MIN=20

# Prompt + response entries go into the hash-chained audit log (audit.jsonl).
# Archive it to a WORM store (S3 Object Lock or on-prem equivalent).
GATEWAY_LOG_PROMPTS=true

# Redact SSNs, card numbers, DOBs, emails and US phone numbers before they reach the audit log.
# Pattern-based, not PHI de-identification: names, addresses and MRNs are NOT redacted.
# Set to false only if your policy requires verbatim records AND the log store
# has the same access controls as the source system.
GATEWAY_REDACT_PROMPTS=true
GATEWAY_LOG_DIR=/var/log/private-llm-platform

GATEWAY_DB_PATH=/var/lib/private-llm-platform/gateway.db

# Leave blank — let the installer generate the bootstrap key and print it
# once to the console. Rotate it immediately after and store in a vault.
GATEWAY_ADMIN_BOOTSTRAP_KEY=

# Document collections: only admins and explicit grants (collection or document access lists, or
# reader:<collection> roles from SSO groups) can read a collection. "open" lets every user-role caller
# read collections that have no access list.
GATEWAY_COLLECTION_DEFAULT_ACCESS=restricted

# Encryption at rest for document passages and vectors (and the free-text fields of audit entries).
# Create a keyring first, store it apart from backups, then uncomment:
#   python scripts/keys.py generate --keyring /etc/private-llm-platform/keyring.json --activate
# GATEWAY_ENCRYPT_AT_REST=true
# GATEWAY_AUDIT_ENCRYPT_TEXT=true
# GATEWAY_ENCRYPTION_KEY_FILE=/etc/private-llm-platform/keyring.json

# Model supply chain: serve only models pinned in the lock file whose digest matches what the model
# server reports (403 otherwise). Pin after installing models, review the digests, then restart:
#   python scripts/pin_models.py --out /etc/private-llm-platform/models.lock.json
GATEWAY_MODEL_POLICY=enforce
GATEWAY_MODEL_LOCK_FILE=/etc/private-llm-platform/models.lock.json
