# Inference backend: ollama (default) or openai_compatible (vLLM, SGLang, TGI, NVIDIA NIM, ...)
BACKEND=ollama
OLLAMA_HOST=http://127.0.0.1:11434
# Used when BACKEND=openai_compatible. Include the /v1 suffix. The key is sent upstream as a bearer token.
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPAT_API_KEY=
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_DEFAULT_MODEL=llama3.1:8b
GATEWAY_EMBED_MODEL=nomic-embed-text   # for document Q&A: ollama pull nomic-embed-text
GATEWAY_MAX_UPLOAD_MB=20
GATEWAY_RATE_LIMIT_PER_MIN=60
GATEWAY_LOG_PROMPTS=false      # record prompts/completions in the hash-chained audit log
GATEWAY_REDACT_PROMPTS=false   # redact PII in those entries
GATEWAY_DB_PATH=./gateway.db
GATEWAY_LOG_DIR=./logs
# Leave blank to let the installer generate one and print it on first run
GATEWAY_ADMIN_BOOTSTRAP_KEY=
# Prometheus metrics at /metrics. Set a token to require "Authorization: Bearer <token>" from scrapers.
GATEWAY_METRICS_ENABLED=true
GATEWAY_METRICS_TOKEN=
# OIDC / SSO: accept JWT access tokens from your identity provider alongside API keys.
GATEWAY_OIDC_ENABLED=false
# Issuer must equal the token's iss (e.g. https://idp.example.com/realms/corp); audience must be in its aud.
GATEWAY_OIDC_ISSUER=
GATEWAY_OIDC_AUDIENCE=
# Blank: discovered from the issuer's /.well-known/openid-configuration
GATEWAY_OIDC_JWKS_URL=
GATEWAY_OIDC_ALGORITHMS=RS256,ES256
GATEWAY_OIDC_CLOCK_SKEW_SECONDS=60
GATEWAY_OIDC_JWKS_CACHE_SECONDS=3600
GATEWAY_OIDC_GROUPS_CLAIM=groups
GATEWAY_OIDC_USERNAME_CLAIM=sub
# IdP group -> roles: admin, user, reader:<collection>, reader:*
GATEWAY_OIDC_GROUP_ROLES={"llm-admins": ["admin"], "staff": ["user"]}
GATEWAY_OIDC_ALLOW_HTTP=false
# Collections without an access list: open (any user-role caller, the v0.5 behavior) or restricted
GATEWAY_COLLECTION_DEFAULT_ACCESS=open
# Document retrieval: hybrid (BM25 + vectors fused with RRF), vector (v0.5 behavior) or bm25
GATEWAY_RETRIEVAL_MODE=hybrid
GATEWAY_RRF_K=60
# Reranker: none, lexical, or cross_encoder (pip install sentence-transformers; local model path below)
GATEWAY_RERANKER=none
GATEWAY_RERANK_CANDIDATES=20
GATEWAY_CROSS_ENCODER_MODEL=
# Encryption at rest (passages, vectors; optionally audit free-text fields). Needs a key:
# a keyring file (python scripts/keys.py generate --keyring ./keyring.json --activate) or one base64 32-byte key.
GATEWAY_ENCRYPT_AT_REST=false
GATEWAY_ENCRYPTION_KEY_FILE=
GATEWAY_ENCRYPTION_KEY=
GATEWAY_AUDIT_ENCRYPT_TEXT=false
# Model supply chain: lock file of pinned digests (see models.lock.example.json, scripts/pin_models.py)
# and a policy for unpinned/mismatched models: off, warn (serve and flag) or enforce (refuse with 403).
GATEWAY_MODEL_LOCK_FILE=
GATEWAY_MODEL_POLICY=warn
GATEWAY_MODEL_VERIFY_INTERVAL_SECONDS=300
